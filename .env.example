# Entorno
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL (Ajustar credenciales según tu entorno)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgcs_db?schema=public"

# Seguridad y Autenticación JWT (RNF-01, RNF-02)
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-utp-clara"
JWT_EXPIRES_IN="8h"
